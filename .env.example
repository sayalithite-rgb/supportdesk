# API Settings
PORT=3000
NODE_ENV=development

# PostgreSQL connection for apps/api/prisma/schema.prisma
# Replace YOUR_POSTGRES_PASSWORD with the password for the local PostgreSQL instance.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/supportdesk?schema=public

# Replace with a random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15