{
  "name": "api",
  "version": "1.0.0",
  "description": "SupportDesk API",
  "main": "index.js",
  "scripts": {
  "build": "tsc",
  "start": "node dist/app.js",
  "dev": "tsx watch src/server.ts",
  "typecheck": "tsc --noEmit",
  "test": "jest",
  "test:unit": "jest src/tests/ --testPathPattern=\"(?!int\\.test\\.ts)\"",
  "test:int": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/supportdesk_test\" jest src/tests/integration/",
  "test:coverage": "jest --coverage"
},
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.x.x",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^5.x.x",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
